{
    "name": "@apify-evals/judge",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "description": "Judge Actor for ai-team#242/#244: reads eval traces from Langfuse, applies the versioned rubric, writes versioned scores back. Never starts the evaluated agent.",
    "main": "dist/main.js",
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@apify-evals/contract": "*",
        "@langfuse/client": "^5.10.1",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "apify": "^3.7.0",
        "ajv": "^8.20.0",
        "yaml": "^2.8.0",
        "@langfuse/tracing": "^5.10.1",
        "@langfuse/otel": "^5.10.1",
        "@opentelemetry/sdk-node": "^0.205.0",
        "@opentelemetry/api": "^1.9.0"
    },
    "devDependencies": {
        "@apify/eslint-config": "^2.0.0",
        "@langfuse/core": "^5.10.1",
        "@types/node": "^24.0.0",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "globals": "^17.0.0",
        "tsx": "^4.20.3",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.58.0",
        "vitest": "^4.1.0"
    },
    "scripts": {
        "start": "node dist/main.js",
        "build": "tsc",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
