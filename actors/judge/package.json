{
    "name": "@apify-evals/judge",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "description": "Judge Actor for ai-team#242/#244: reads eval traces from Langfuse, applies the versioned rubric, writes versioned scores back. Never starts the evaluated agent.",
    "main": "dist/main.js",
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@apify-evals/contract": "*",
        "@langfuse/client": "^5.10.1",
        "apify": "^3.7.0",
        "ajv": "^8.20.0"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "typescript": "^6.0.0",
        "tsx": "^4.20.3",
        "vitest": "^4.1.0"
    },
    "scripts": {
        "start": "node dist/main.js",
        "build": "tsc",
        "test": "vitest run",
        "create-score-configs": "tsx scripts/create-score-configs.ts",
        "typecheck": "tsc -p tsconfig.check.json"
    }
}
