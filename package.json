{
    "name": "apify-evals",
    "private": true,
    "type": "module",
    "workspaces": [
        "shared",
        "contract",
        "actors/*",
        "tools"
    ],
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "npm test --workspaces --if-present",
        "scenarios:check": "npm run scenarios:check --workspaces --if-present",
        "scenarios:sync": "npm run scenarios:sync --workspaces --if-present"
    }
}
